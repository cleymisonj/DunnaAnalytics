{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/stock.js": {
      "includeFiles": "server/public-stock.json"
    },
    "api/backend.js": {
      "includeFiles": "server/seed.json",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/uploads/:path*",
      "destination": "/api/backend?__path=uploads/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/backend?__path=:path*"
    }
  ]
}
