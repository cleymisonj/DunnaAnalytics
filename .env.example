# Configuração somente do servidor. Copie para .env e configure localmente.
# Nunca use prefixo VITE_ para chaves nem compartilhe a chave no chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# DUNNA_DATA_DIR=C:/caminho/persistente/dunna-data
# COOKIE_SECURE=true

# Supabase: somente no servidor. Não configure SERVICE_ROLE com prefixo VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DUNNA_STOCK_SOURCE=supabase

# E-mail (Resend): avisos e recuperação de senha
# RESEND_API_KEY=
# DUNNA_NOTIFY_EMAIL=
# DUNNA_NOTIFY_FROM=
# Endereço do painel nos links enviados por e-mail
# DUNNA_SITE_URL=https://seu-painel.vercel.app
